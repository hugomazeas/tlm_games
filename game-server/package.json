{
    "name": "hot-potato-server",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "bun src/server.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "devDependencies": {
        "@types/bun": "1.3.0",
        "typescript": "5.9.3",
        "prettier": "3.6.2"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "semi": false,
        "singleQuote": true,
        "arrowParens": "avoid",
        "trailingComma": "es5"
    }
}
