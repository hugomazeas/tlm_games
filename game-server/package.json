{
    "name": "hot-potato-server",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "bun src/server.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.ts\"",
        "race:map": "bun src/race/map/build.ts",
        "race:viewer": "bun src/race/poc-server.ts"
    },
    "devDependencies": {
        "@types/bun": "1.3.0",
        "@types/three": "0.180.0",
        "prettier": "3.6.2",
        "typescript": "5.9.3"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "semi": false,
        "singleQuote": true,
        "arrowParens": "avoid",
        "trailingComma": "es5"
    },
    "dependencies": {
        "three": "0.180.0"
    }
}
